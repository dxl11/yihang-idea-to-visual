{
  "version": "1.0",
  "skill_id": "yihang-idea-to-visual",
  "module": "photo-to-poster",
  "canvas": {
    "aspect": "3:4",
    "width": 1080,
    "height": 1440
  },
  "rules": {
    "one_photo_one_poster": true,
    "forbid_collage": true,
    "forbid_multi_photo_single_job": true,
    "top_uses_source_pixels": true,
    "bottom_is_generated_art": true
  },
  "base_prompt": "prompts/base-prompt.md",
  "styles": [
    {
      "id": "01-minimal-abstract",
      "name_en": "Minimal Abstract",
      "name_zh": "极简几何抽象海报",
      "category": "minimal-abstract",
      "ratio_top": 0.5,
      "ratio_bottom": 0.5,
      "recommended_photo_types": ["architecture", "product", "portrait", "still-life"],
      "core_features": ["geometric blocks", "large negative space", "2-4 restrained colors"],
      "prompt_path": "prompts/01-minimal-abstract.md",
      "use_cases": ["international studio look", "architecture poster", "gallery poster"]
    },
    {
      "id": "02-linocut-travel",
      "name_en": "Linocut Travel",
      "name_zh": "油毡版画旅行手记",
      "category": "print-travel",
      "ratio_top": 0.45,
      "ratio_bottom": 0.55,
      "recommended_photo_types": ["travel", "landscape", "street", "architecture"],
      "core_features": ["linocut / stencil", "torn paper edge", "misregistration"],
      "prompt_path": "prompts/02-linocut-travel.md",
      "use_cases": ["travel journal", "indie magazine", "poetic diptych"]
    },
    {
      "id": "03-raster-distortion",
      "name_en": "Raster Distortion",
      "name_zh": "光栅线场实验海报",
      "category": "experimental",
      "ratio_top": 0.5,
      "ratio_bottom": 0.5,
      "recommended_photo_types": ["portrait", "sculpture", "architecture", "product"],
      "core_features": ["parallel line field", "controlled distortion", "optical push"],
      "prompt_path": "prompts/03-raster-distortion.md",
      "use_cases": ["experimental art", "optical illusion show"]
    },
    {
      "id": "04-swiss-editorial",
      "name_en": "Swiss Editorial",
      "name_zh": "瑞士国际主义编辑设计",
      "category": "editorial-modernist",
      "ratio_top": 0.5,
      "ratio_bottom": 0.5,
      "recommended_photo_types": ["architecture", "product", "portrait", "still-life"],
      "core_features": ["modular grid", "geometric slices", "black / ivory / accent"],
      "prompt_path": "prompts/04-swiss-editorial.md",
